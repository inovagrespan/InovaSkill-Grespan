{
  "Assistant": {
    "Model": "gpt-5.4",
    "EmbeddingModel": "text-embedding-3-small",
    "MaximumQuestionLength": 800,
    "MaximumToolExecutionsPerMessage": 5,
    "MaximumHistoryMessages": 20,
    "MaximumGeneralSearchResults": 20,
    "OpenAiTimeoutSeconds": 30,
    "ToolTimeoutSeconds": 10,
    "ExternalResearchEnabled": true,
    "MaximumExternalResearchesPerMessage": 1,
    "ExternalResearchTimeoutSeconds": 20
  },
  "WhatsApp": {
    "BaseUrl": "http://localhost:8081",
    "InstanceName": "grespan",
    "WebhookSecret": "local-whatsapp-bridge-secret",
    "VerificationCodeLifetimeMinutes": 10,
    "MaximumVerificationAttempts": 5,
    "GatewayTimeoutSeconds": 20,
    "MaximumAudioBytes": 10485760,
    "ConnectionPollingSeconds": 10,
    "MessageAggregationMilliseconds": 1000,
    "FloodWindowSeconds": 30,
    "FloodMaximumMessages": 8,
    "FloodCooldownSeconds": 30
  },
  "ConnectionStrings": {
    "ImportDb": "Host=localhost;Port=5432;Database=inovaskill_importer;Username=postgres;Password=postgres"
  },
  "Hangfire": {
    "Enabled": true,
    "Storage": {
      "SchemaName": "hangfire"
    },
    "Workers": {
      "Imports": 2,
      "Default": 2
    }
  },
  "BrasilApi": {
    "BaseUrl": "https://brasilapi.com.br/api/",
    "RequestsPerSecond": 1,
    "TimeoutSeconds": 30,
    "UserAgent": "InovaSkill-Grespan/1.0",
    "RateLimitMaximumRetries": 4,
    "RateLimitFallbackDelaySeconds": 60,
    "RateLimitMaximumDelaySeconds": 480,
    "RateLimitJitterMaximumMilliseconds": 1000,
    "PersistenceBatchSize": 25
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "InovaSkill-Grespan/1.0",
    "MinimumRequestIntervalMilliseconds": 1000,
    "TimeoutSeconds": 30,
    "PersistenceBatchSize": 25
  },
  "GoogleGeocoding": {
    "BaseUrl": "https://geocode.googleapis.com/v4/",
    "TimeoutSeconds": 30,
    "MinimumRequestIntervalMilliseconds": 500,
    "RateLimitMaximumRetries": 4,
    "RateLimitFallbackDelaySeconds": 5,
    "RateLimitMaximumDelaySeconds": 60
  },
  "Osrm": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 30,
    "MatrixBlockSize": 50,
    "MaximumParallelRequests": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
