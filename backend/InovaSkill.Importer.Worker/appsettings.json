{
  "ConnectionStrings": {
    "ImportDb": "Host=localhost;Port=5432;Database=inovaskill_importer;Username=postgres;Password=postgres"
  },
  "Hangfire": {
    "Enabled": true,
    "Storage": {
      "SchemaName": "hangfire"
    },
    "Workers": {
      "Imports": 2,
      "RouteOptimization": 2,
      "Default": 2
    }
  },
  "RouteOptimization": {
    "DistanceProvider": "Osrm",
    "OsrmBaseUrl": "http://localhost:5000",
    "OsrmTimeoutSeconds": 10,
    "MaximumMatrixPoints": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
