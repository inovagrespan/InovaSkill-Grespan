{
  "ConnectionStrings": {
    "ImportDb": "Host=localhost;Port=5432;Database=inovaskill_importer;Username=postgres;Password=postgres"
  },
  "Hangfire": {
    "Enabled": true,
    "Storage": {
      "SchemaName": "hangfire"
    },
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "AllowAnonymous": false
    },
    "Workers": {
      "Imports": 2,
      "Detectors": 2,
      "Default": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
