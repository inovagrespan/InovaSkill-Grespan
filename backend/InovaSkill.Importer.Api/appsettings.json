{
  "ConnectionStrings": {
    "ImportDb": "Host=localhost;Port=5432;Database=inovaskill_importer;Username=postgres;Password=postgres"
  },
  "Assistant": {
    "Model": "gpt-5.4",
    "MaximumQuestionLength": 800,
    "MaximumToolExecutionsPerMessage": 5,
    "MaximumHistoryMessages": 20,
    "MaximumGeneralSearchResults": 20,
    "OpenAiTimeoutSeconds": 30,
    "ToolTimeoutSeconds": 10
  },
  "Hangfire": {
    "Enabled": true,
    "Storage": {
      "SchemaName": "hangfire"
    },
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "AllowAnonymous": false
    },
    "Workers": {
      "Imports": 2,
      "RouteOptimization": 2,
      "Default": 2
    }
  },
  "RouteOptimization": {
    "DistanceProvider": "Osrm",
    "OsrmBaseUrl": "http://localhost:5000",
    "OsrmTimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
