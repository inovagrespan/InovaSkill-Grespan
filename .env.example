# Valores locais demonstrativos. Copiar para .env só é necessário para personalizar.
POSTGRES_DB=inovaskill_importer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

API_PORT=5279
FRONTEND_PORT=80
JWT_SECRET=local-mvp-secret-change-before-production-2026

# O chat de IA fica indisponível sem uma chave, mas o restante da aplicação funciona.
OPENAI_API_KEY=

# Geographic funciona sem serviço adicional. Para OSRM, prepare infra/osrm e use o perfil osrm.
ROUTE_DISTANCE_PROVIDER=Geographic
OSRM_BASE_URL=http://osrm:5000
