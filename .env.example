# Valores locais demonstrativos. Copiar para .env só é necessário para personalizar.
POSTGRES_DB=inovaskill_importer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

API_PORT=5279
FRONTEND_PORT=80
JWT_SECRET=local-mvp-secret-change-before-production-2026

# O chat de IA fica indisponível sem uma chave, mas o restante da aplicação funciona.
OPENAI_API_KEY=

# Opcional: quando preenchida, prioriza coordenadas prediais do Google no job de geocodificação.
GOOGLE_MAPS_API_KEY=

WHATSAPP_BRIDGE_PORT=8081
WHATSAPP_INSTANCE_NAME=grespan
WHATSAPP_WEBHOOK_SECRET=local-whatsapp-bridge-secret

# API OSRM interna. O serviço e o mapa não sobem automaticamente com a aplicação.
OSRM_BASE_URL=http://localhost:5000
